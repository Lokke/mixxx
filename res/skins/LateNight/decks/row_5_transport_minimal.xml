<!--
  Minimal transport row for the full deck.

  Derived from row_5_transportLoopJump.xml, stripped down to the essentials:
      [ PLAY ]  [ EJECT ]  [ FX1 FX2 ]  Titel / Interpret      (Position)
  Play: left click play/pause, right click cue_set. Eject unloads the track.
  Cue, Reverse, Loop, Beatjump, Hotcues and Intro/Outro markers are
  intentionally not included.
-->
<Template>
  <SetVariable name="BtnType"><Variable name="SubRegion_BtnType"/></SetVariable>
  <SetVariable name="BtnSize">square</SetVariable>

  <WidgetGroup>
    <SizePolicy>me,min</SizePolicy>
    <Layout>horizontal</Layout>
    <Children>

      <WidgetGroup>
        <ObjectName>DeckRow_5_TransportMinimal</ObjectName>
        <SizePolicy>me,min</SizePolicy>
        <Layout>horizontal</Layout>
        <Children>

          <WidgetGroup><!-- Play + PlayBlink + default dark background -->
            <Layout>horizontal</Layout>
            <SizePolicy>max,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>stacked</Layout>
                <Size>68f,26f</Size>
                <Children>
                  <Template src="skins:LateNight/controls/button_play_2state_right_display.xml">
                    <SetVariable name="TooltipId">play_cue_set</SetVariable>
                    <SetVariable name="ObjectName">PlayDeck</SetVariable>
                    <SetVariable name="Size">68f,26f</SetVariable>
                    <SetVariable name="BtnSize">play</SetVariable>
                    <SetVariable name="ConfigKey"><Variable name="Group"/>,play</SetVariable>
                    <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,cue_set</SetVariable>
                    <SetVariable name="ConfigKeyDisp"><Variable name="Group"/>,play_latched</SetVariable>
                  </Template>
                  <PushButton>
                    <ObjectName>PreviewIndicator</ObjectName>
                    <Size>68f,26f</Size>
                    <NumberStates>2</NumberStates>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                    </Connection>
                  </PushButton>
                  <PushButton>
                    <ObjectName>PlayIndicator</ObjectName>
                    <Size>68f,26f</Size>
                    <NumberStates>2</NumberStates>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,play_indicator</ConfigKey>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup><!-- Play + PlayBlink + default dark background -->
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>2f,0min</Size></WidgetGroup><!--  = 2-10px wide -->

          <!-- Eject: unloads the track from the deck -->
          <Template src="skins:LateNight/controls/button_1state.xml">
            <SetVariable name="TooltipId">eject</SetVariable>
            <SetVariable name="ObjectName">EjectButton</SetVariable>
            <SetVariable name="Size">26f,26f</SetVariable>
            <SetVariable name="state_0_text"></SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,eject</SetVariable>
          </Template>

          <WidgetGroup><Size>4f,0min</Size></WidgetGroup>

          <!-- FX unit assign buttons, right behind Play/Eject -->
          <Template src="skins:LateNight/fx/assign_buttons.xml"/>

          <WidgetGroup><Size>4f,0min</Size></WidgetGroup>

          <!-- Track info, right behind the transport buttons -->
          <WidgetGroup>
            <ObjectName>DeckTrackInfoCompact</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>

              <TrackProperty>
                <ObjectName>DeckTitleCompact</ObjectName>
                <Size>me,13f</Size>
                <TooltipId>track_title</TooltipId>
                <Property>titleInfo</Property>
                <Alignment>Left</Alignment>
                <Elide>right</Elide>
                <Channel><Variable name="ChanNum"/></Channel>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </TrackProperty>

              <TrackProperty>
                <ObjectName>DeckArtistCompact</ObjectName>
                <Size>me,13f</Size>
                <TooltipId>track_artist</TooltipId>
                <Property>artist</Property>
                <Alignment>Left</Alignment>
                <Elide>right</Elide>
                <Channel><Variable name="ChanNum"/></Channel>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </TrackProperty>

            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>4f,0min</Size></WidgetGroup>

          <NumberPos>
            <ObjectName>PlayPositionText</ObjectName>
            <TooltipId>track_time</TooltipId>
            <Size>0min,26f</Size>
            <Alignment>right</Alignment>
            <Channel><Variable name="ChanNum"/></Channel>
            <Connection>
              <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
            </Connection>
          </NumberPos>

          <WidgetGroup><Size>0min,0min</Size></WidgetGroup>

        </Children>
      </WidgetGroup><!-- DeckRow_5_TransportMinimal -->

    </Children>
  </WidgetGroup>
</Template>
